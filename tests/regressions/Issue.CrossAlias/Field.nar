// Regression: a record alias declared in one module and used as a
// generic type argument in *another* module's record alias
// (`Dict[Int, Tile]` where `Tile` carries a `Maybe[Building]` field
// from a third module) must propagate enough type information that
// `Dict.get` returns a concrete `Maybe[Tile]` rather than
// `Maybe[<unbound>]`. Failure mode: pattern checks reject
// `case Just(t) =>` with "Data option pattern should have a data
// type" because `type_.kind` stays `TUnbound`.

module Issue.CrossAlias.Field

import Nar.Base.Maybe exposing (Maybe)
import Nar.Base.Dict exposing (Dict)

alias Field =
  { slots: Dict[Int, Tile]
  }

def empty: Field =
  { slots = Dict.empty }

def tileAt(f: Field, idx: Int) -> Maybe[Tile] =
  Dict.get(idx, f.slots)

def hasBuilding(f: Field, idx: Int) -> Bool =
  select tileAt(f, idx)
    case Nothing => False
    case Just(t) =>
      select t.building
        case Nothing => False
        case Just(_) => True
      end
  end
